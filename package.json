{
  "name": "agents-council",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "files": [
    "scripts/*.cjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "council": "scripts/cli.cjs"
  },
  "occult": {
    "contractVersions": [
      "1.0.0"
    ],
    "featureGate": "OCCULT_ENABLED"
  },
  "scripts": {
    "build": "bun build src/cli/index.ts --compile --outfile dist/council",
    "cli": "bun src/cli/index.ts",
    "desktop:dev": "electrobun dev",
    "desktop:build": "electrobun build",
    "desktop:build:stable": "electrobun build --env=stable",
    "test": "bun test",
    "release:manifest": "bun scripts/generateOccultReleaseManifest.ts",
    "npm:prepare:scoped": "node scripts/prepareScopedNpmPackages.mjs",
    "npm:prepare:bootstrap": "node scripts/prepareNpmBootstrapPackages.mjs",
    "npm:pack:scoped": "node scripts/packScopedNpmPackages.mjs",
    "npm:test:scoped": "node --test scripts/prepareScopedNpmPackages.test.mjs",
    "test:occult-hermes-e2e": "bun scripts/occultHermesE2E.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "package.json": [
      "biome check --write --files-ignore-unknown=true"
    ],
    "*.json": [
      "biome check --write --files-ignore-unknown=true"
    ],
    "src/**/*.{ts,js}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.76",
    "@biomejs/biome": "2.3.10",
    "@modelcontextprotocol/sdk": "1.25.1",
    "@openai/codex-sdk": "0.79.0",
    "@types/bun": "1.3.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electrobun": "1.13.1",
    "@uiw/react-markdown-preview": "5.1.5",
    "commander": "14.0.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "zod": "4.2.1"
  },
  "author": "Alex Gavrilescu (https://github.com/MrLesk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SgtSlummy/agents-council.git"
  },
  "bugs": {
    "url": "https://github.com/SgtSlummy/agents-council/issues"
  },
  "homepage": "https://github.com/SgtSlummy/agents-council",
  "keywords": [
    "mcp",
    "council",
    "agents",
    "cli",
    "mcp-server"
  ],
  "license": "MIT"
}
